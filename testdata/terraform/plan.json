{
  "resource_changes": [
    {
      "address": "helm_release.remote",
      "type": "helm_release",
      "change": {
        "after": {
          "chart": "podinfo",
          "repository": "https://stefanprodan.github.io/podinfo",
          "version": "6.5.0",
          "set": [
            {"name": "image.repository", "value": "ghcr.io/example/app"},
            {"name": "image.tag", "value": "1.2.3"}
          ]
        }
      }
    },
    {
      "address": "kubernetes_deployment_v1.api",
      "type": "kubernetes_deployment_v1",
      "change": {
        "after": {
          "spec": [{
            "template": [{
              "spec": [{
                "container": [{"name": "api", "image": "busybox:1.36"}]
              }]
            }]
          }]
        }
      }
    }
  ]
}
